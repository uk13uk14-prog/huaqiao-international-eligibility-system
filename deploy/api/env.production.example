# 复制到 M1 上 Free backend / SaaS backend 的生产 .env（勿提交真实密钥）

# --- SaaS Pro (huaqiao-saas-pro/backend) ---
ENV=production
PUBLIC_BASE_URL=https://api.guoqiaoplan.com
FRONTEND_BASE_URL=https://app.guoqiaoplan.com
CORS_ORIGINS=https://app.guoqiaoplan.com,https://huaqiao-international-eligibility-system.rambolluk.workers.dev
# DATABASE_URL=...   # 保持现有库，禁止迁移到未知新环境
# JWT_SECRET_KEY=...
# VAULT_FERNET_KEY=...
# ADMIN_TOKEN=...

# --- Free backend (backend/) ---
# ENV=production
# CORS_ORIGINS=https://app.guoqiaoplan.com,https://huaqiao-international-eligibility-system.rambolluk.workers.dev
# DATABASE_URL=...   # 保持现有库
# ADMIN_TOKEN=...
