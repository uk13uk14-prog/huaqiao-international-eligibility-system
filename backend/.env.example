APP_NAME=华侨生国际生资格智能判定系统
ENV=development
DATABASE_URL=sqlite:///./eligibility.db
# 生产务必精确列出 H5 来源（禁止 *）。示例：
# CORS_ORIGINS=https://app.guoqiaoplan.com,https://huaqiao-international-eligibility-system.rambolluk.workers.dev
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174
# 管理后台 /api/admin/* 与 /admin 页面；请改为强随机字符串
ADMIN_TOKEN=
AI_API_KEY=
AI_BASE_URL=https://api.example.com/v1
AI_MODEL=default-chat-model
