# Local / staging Admin Console
# Copy to .env.local for overrides (never commit secrets)

# SaaS backend base URL (no trailing slash). Leave empty to use Vite proxy / same-origin.
VITE_ADMIN_API_BASE=http://127.0.0.1:8010

# Production builds use committed .env.production:
#   VITE_ADMIN_API_BASE=https://api.guoqiaoplan.com
# Dev server: npm run dev -- --host 0.0.0.0 --port 5190
