{
  "name": "huaqiao-admin",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5190",
    "build": "vite build && node scripts/assert-public-api.mjs",
    "preview": "vite preview --host 0.0.0.0 --port 4190",
    "build:cap": "CAPACITOR=1 vite build && node scripts/assert-public-api.mjs",
    "cap:sync": "npm run build:cap && npx cap sync android",
    "cap:open": "npx cap open android",
    "apk:debug": "npm run cap:sync && cd android && ./gradlew assembleDebug"
  },
  "dependencies": {
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.1",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3",
    "@element-plus/icons-vue": "^2.3.1",
    "element-plus": "^2.8.4",
    "vue": "^3.5.11",
    "vue-router": "^4.4.5"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.1",
    "@capacitor/cli": "^8.5.1",
    "@vitejs/plugin-vue": "^5.1.4",
    "playwright-core": "^1.62.1",
    "vite": "^5.4.8"
  }
}
